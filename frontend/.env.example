# ═══════════════════════════════════════════════════════
#  ZWIGATO FRONTEND ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════
#
# Copy this file to .env and update with your actual values
# File: .env.example → .env
#

# ═══════════════════════════════════════════════════════
#  API Configuration
# ═══════════════════════════════════════════════════════

# Backend API Base URL
# Development: http://localhost:8080/api
# Production: https://your-domain.com/api
VITE_API_BASE_URL=http://localhost:8080/api

# ═══════════════════════════════════════════════════════
#  Payment Gateway Configuration
# ═══════════════════════════════════════════════════════

# Razorpay API Key ID (for payment integration)
# Sign up at https://razorpay.com to get test/live keys
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id_here

# ═══════════════════════════════════════════════════════
#  Maps & Location Services (Optional)
# ═══════════════════════════════════════════════════════

# Google Maps API Key (for location features)
# Get your API key from: https://console.cloud.google.com/
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ═══════════════════════════════════════════════════════
#  Application Configuration
# ═══════════════════════════════════════════════════════

# Application Name
VITE_APP_NAME=Zwigato

# Application Environment (development | production | staging)
VITE_APP_ENV=development

# Enable Debug Mode (true | false)
VITE_DEBUG=true

# ═══════════════════════════════════════════════════════
#  WebSocket Configuration (Optional)
# ═══════════════════════════════════════════════════════

# WebSocket URL for real-time updates
VITE_WS_URL=ws://localhost:8080/ws

# ═══════════════════════════════════════════════════════
#  Analytics & Monitoring (Optional)
# ═══════════════════════════════════════════════════════

# Google Analytics Tracking ID
# VITE_GA_TRACKING_ID=UA-XXXXXXXXX-X

# Sentry DSN for error tracking
# VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# ═══════════════════════════════════════════════════════
#  NOTES
# ═══════════════════════════════════════════════════════
#
# 1. All environment variables must be prefixed with VITE_
# 2. After changing this file, restart the dev server
# 3. Never commit .env file with actual credentials to Git
# 4. For production, use your hosting provider's environment
#    variable management (Vercel, Netlify, AWS, etc.)
#
